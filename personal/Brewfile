# ── Languages & Runtimes ──────────────────────────────────────────────────────
# brew "python@3.8", link: false  # removed from Homebrew — use `uv python install 3.8` instead
# brew "python@3.9", link: false  # deprecated by Homebrew — use `uv python install 3.9` instead
brew "node"
brew "nvm"
brew "uv"

# ── Image Processing ──────────────────────────────────────────────────────────
brew "freetype"     # renders fonts (used by imagemagick)
brew "fontconfig"   # finds and configures fonts (used by imagemagick)
brew "harfbuzz"     # shapes text for correct letter spacing (used by imagemagick)
brew "openjpeg"     # reads and writes JPEG 2000 images
brew "webp"         # reads and writes WebP images
brew "leptonica"    # image analysis library (used by tesseract)
brew "tesseract"    # reads text from images (OCR)
brew "libheif"      # reads and writes HEIC images, like iPhone photos
brew "imagemagick"  # convert, resize and edit images from the command line
brew "pngquant"     # shrinks PNG files with little visible quality loss
brew "ghostscript"  # reads PDF and EPS files (lets imagemagick convert them)

# ── Media & Video ─────────────────────────────────────────────────────────────
brew "libass"
brew "libbluray"

# ── CLI Utilities ─────────────────────────────────────────────────────────────
brew "tree"

# ── Build Tools & Libraries ───────────────────────────────────────────────────
brew "cmake"
